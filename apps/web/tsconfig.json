{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "skipLibCheck": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@mag/*": ["../../packages/mag/src/*"], "@export/*": ["../../packages/export/src/*"], "@terv/*": ["../../packages/terv/src/*"], "pdfjs-dist": ["./node_modules/pdfjs-dist"], "pdfjs-dist/*": ["./node_modules/pdfjs-dist/*"], "pdf-lib": ["./node_modules/pdf-lib"] }
  },
  "include": ["src", "../../packages/terv/src"]
}
