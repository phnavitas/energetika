// Cloudflare Worker statikus eszközökkel: a webes felület (apps/web) build-kimenetét szolgálja ki,
// a /api/* útvonalakat (PVGIS és címkereső proxy) a worker/index.js kezeli.
// A `wrangler deploy` maga futtatja a buildet (build.command), így a Cloudflare felületen csak a
// Deploy command kell: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "energetika",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "cd apps/web && npm ci && npm run build"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
